# The engine clone, its build and the downloaded kfm_arena (tools/*_kfm_arena.sh).
/.kfm/
# Built modules and play results (tools/build.sh, tools/build_in_sandbox.sh, tools/play.sh, CI):
# modules are rebuilt by the recipe, never committed.
/out/
/examples/**/*.wasm
# The ladder service's build (service/README.md).
/service/target/
# The kfm CLI's build and wheels (cli/README.md).
/cli/target/
# A filled-in ladder.env must never be committed (deploy/README.md "Day one").
/deploy/vm/ladder.env
/deploy/vm/build.env
