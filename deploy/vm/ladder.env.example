# /etc/kfm/ladder.env: read by the kfm-* units on both ladder VMs, by Caddy (a drop-in
# install.sh adds) and by install.sh, update.sh and postgres-backup.sh. systemd
# EnvironmentFile syntax: KEY=value, no `export`, no quotes needed, no shell expansion (so a
# value written twice, POSTGRES_PASSWORD inside DATABASE_URL, is written out twice). Mode 0600,
# owner root. Never commit a filled-in copy.
#
# Each unit hands its container only the variables its role needs (deploy/README.md "What
# runs where"): the build VM's file needs the lines marked [build] and nothing else, so the
# OAuth secrets and the session key never reach the machine that runs untrusted builds.
#   [ladder]  kfm-ladder-1 (API, portal, Postgres, match workers, backups)
#   [build]   kfm-build-1 (the build worker)

# --- Images ([ladder] [build]) -------------------------------------------------------------
# ghcr.io/<owner> (lower case) and the release tag of this repository that release.yml
# pushed; update.sh rewrites KFM_IMAGE_TAG.
KFM_IMAGE_REPO=ghcr.io/minip8
KFM_IMAGE_TAG=v0.1.0

# Optional: credentials for private GHCR packages (a classic PAT with read:packages). Leave
# empty when the packages are public.
KFM_GHCR_USER=
KFM_GHCR_TOKEN=

# --- Database ------------------------------------------------------------------------------
# [ladder] The password of the Postgres role `kfm` (database `kfm`), set when the data
# directory /var/lib/kfm/postgres is first created; changing it later needs ALTER ROLE too.
# Generate with: openssl rand -hex 24 (hex, so it needs no escaping inside the URL)
POSTGRES_PASSWORD=

# [ladder] Where Postgres listens (listen_addresses). `*` lets the build VM in over the
# private network; the provider firewall admits TCP 5432 from the build VM only (GCP rule
# kfm-ladder-postgres, Hetzner: the private network, deploy/hetzner.md). 127.0.0.1 when no
# build VM uses this database.
KFM_POSTGRES_LISTEN=*

# [ladder] [build] The service's database. On kfm-ladder-1:
#   postgres://kfm:<POSTGRES_PASSWORD>@127.0.0.1:5432/kfm
# On kfm-build-1, the ladder VM's private name or address (GCP's internal DNS resolves the
# VM name inside the project; on Hetzner use its private network IP):
#   postgres://kfm:<POSTGRES_PASSWORD>@kfm-ladder-1:5432/kfm
DATABASE_URL=postgres://kfm:CHANGE_ME@127.0.0.1:5432/kfm

# --- The API and portal ([ladder]) ---------------------------------------------------------
# The public name Caddy gets a certificate for (DNS A record -> the ladder VM's static IP).
KFM_LADDER_DOMAIN=ladder.kfm.minip8.com

# Where `kfm-ladder serve` listens: loopback only, Caddy is in front (Caddyfile).
KFM_LADDER_LISTEN=127.0.0.1:8090

# The URL users reach the portal at: the base of the OAuth callbacks
# (<url>/auth/github/callback, <url>/auth/google/callback) and of every link the API returns.
KFM_LADDER_PUBLIC_URL=https://ladder.kfm.minip8.com

# The key that signs portal session cookies: 64 hex characters. Generate with:
#   openssl rand -hex 32
# Changing it signs every user out.
KFM_LADDER_SESSION_KEY=

# The GitHub OAuth app (github.com/settings/developers -> OAuth Apps; callback URL
# <KFM_LADDER_PUBLIC_URL>/auth/github/callback).
KFM_LADDER_GITHUB_CLIENT_ID=
KFM_LADDER_GITHUB_CLIENT_SECRET=

# The Google OAuth client (Google Cloud console -> APIs & Services -> Credentials -> OAuth
# client ID, type Web application; authorised redirect URI
# <KFM_LADDER_PUBLIC_URL>/auth/google/callback).
KFM_LADDER_GOOGLE_CLIENT_ID=
KFM_LADDER_GOOGLE_CLIENT_SECRET=

# --- Object store ([ladder] [build]) -------------------------------------------------------
# S3-compatible storage for sources, modules, build logs, replays and the nightly database
# dump (backups/postgres/). Cloudflare R2: the endpoint is
# https://<account id>.r2.cloudflarestorage.com, the region `auto`, the keys an R2 API token
# with Object Read & Write on the bucket (deploy/README.md "Day one").
KFM_LADDER_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
KFM_LADDER_S3_BUCKET=kfm-ladder
KFM_LADDER_S3_ACCESS_KEY=
KFM_LADDER_S3_SECRET_KEY=
KFM_LADDER_S3_REGION=auto

# --- The engine ----------------------------------------------------------------------------
# Not set here: the image carries the kfm_arena of the engine release it was built with
# (engine.lock's tag=) and sets both. Setting KFM_LADDER_ENGINE_TAG to another tag while
# KFM_LADDER_ARENA is the image's runner makes the container refuse to start.
#KFM_LADDER_ENGINE_TAG=v0.5.1
#KFM_LADDER_ARENA=/opt/kfm/engine/kfm_arena

# --- Workers -------------------------------------------------------------------------------
# [ladder] How many kfm-ladder-match@ instances install.sh starts (one match at a time each).
KFM_MATCH_WORKERS=2

# The build worker's bot build image is not set here either: kfm-ladder-build.service passes
# KFM_BUILD_IMAGE=${KFM_IMAGE_REPO}/kfm-bot-build:${KFM_IMAGE_TAG}, the bot build image of
# the same release (release.yml pushes both).

# --- Optional ([ladder] [build]) -----------------------------------------------------------
# Sentry DSN for the service (empty = off).
SENTRY_DSN=

# [ladder] Days of nightly database dumps kept in the bucket (postgres-backup.sh).
KFM_BACKUP_KEEP_DAYS=30
