# /etc/caddy/Caddyfile on kfm-ladder-1 (deploy/README.md): TLS from Let's Encrypt for the
# ladder's public name, everything proxied to `kfm-ladder serve` on loopback (the API and the
# portal are one binary). KFM_LADDER_DOMAIN comes from /etc/kfm/ladder.env through the drop-in
# install.sh writes (caddy.service.d/kfm-ladder.conf).
{$KFM_LADDER_DOMAIN:ladder.kfm.minip8.com} {
	# A submission is at most 4 MiB of source plus its manifest (docs/ladder-api.md); the
	# service enforces the exact cap, this only stops a stream of junk at the door.
	request_body {
		max_size 8MB
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090 {
		# The client's address, replacing whatever the client sent: the service trusts the
		# first entry for its per-client rate limit (KFM_LADDER_TRUST_PROXY=1).
		header_up X-Forwarded-For {remote_host}
	}
}
