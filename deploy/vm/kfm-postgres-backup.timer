# Nightly database dump (kfm-postgres-backup.service). Persistent: a night the VM was down
# is caught up at the next boot.
[Unit]
Description=Nightly Kung Fu Monkeys ladder database dump
Documentation=https://github.com/minip8/kung-fu-monkeys-bots/blob/main/deploy/README.md

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
