# One match worker, `kfm-ladder worker match` (architecture §11 "M7 step 3 design (v0.63)"):
# it claims `match` jobs from the jobs table and plays each as one kfm_arena process, the
# image's runner of the pinned engine release. A match is already sandboxed (the bots are
# wasm modules under WAMR with instruction metering), so it runs on kfm-ladder-1 beside the
# API; the container adds an unprivileged user, a read-only root, no capabilities and a
# memory cap. Enable kfm-ladder-match@1 ... @N (install.sh does, N = KFM_MATCH_WORKERS).
# Stopping one mid-match is safe: the claim goes stale and the job is re-queued.
[Unit]
Description=Kung Fu Monkeys ladder match worker %i
Documentation=https://github.com/minip8/kung-fu-monkeys-bots/blob/main/deploy/README.md
Requires=docker.service
After=docker.service network-online.target kfm-postgres.service kfm-ladder-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/kfm/ladder.env
ExecStartPre=-/usr/bin/docker rm -f kfm-ladder-match-%i
ExecStart=/usr/bin/docker run --rm --name kfm-ladder-match-%i --network host \
    --log-opt max-size=10m --log-opt max-file=3 \
    --read-only --tmpfs /tmp:size=256m --cap-drop ALL --security-opt no-new-privileges \
    --memory 768m --pids-limit 256 \
    -e DATABASE_URL \
    -e KFM_LADDER_S3_ENDPOINT -e KFM_LADDER_S3_BUCKET -e KFM_LADDER_S3_ACCESS_KEY \
    -e KFM_LADDER_S3_SECRET_KEY -e KFM_LADDER_S3_REGION -e SENTRY_DSN \
    ${KFM_IMAGE_REPO}/kfm-ladder:${KFM_IMAGE_TAG} worker match
ExecStop=/usr/bin/docker stop -t 30 kfm-ladder-match-%i
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
